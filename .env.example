# Configuração do go2-server. Copie para `.env` e ajuste. Todas as chaves têm
# o prefixo GO2S_; a lista completa, com os padrões, está em app/config.py.

# ─── go2-api ──────────────────────────────────────────────────────────────────
# No mesmo PC, fale com ela pelo loopback.
GO2S_GO2_API_URL=http://127.0.0.1:8000
# 1 = antes de um movimento, confere e liga o desvio de obstáculo (como o edge).
#GO2S_ENSURE_OBSTACLE_AVOIDANCE=1

# ─── Transcrição ──────────────────────────────────────────────────────────────
#GO2S_STT_ENGINE=whisper            # whisper | vosk
#GO2S_WHISPER_MODEL=medium          # base | small | medium (meça com scripts/bench_stt.py)
# auto = GPU (CUDA) se houver e funcionar, senão CPU. O medium pede GPU.
#GO2S_WHISPER_DEVICE=auto           # auto | cuda | cpu
# Threads por transcrição na CPU. Baixo de propósito: a go2-api divide o PC.
#GO2S_WHISPER_CPU_THREADS=4
#GO2S_VOSK_MODEL_PATH=models/vosk-model-pt-fb-v0.1.1-20220516_2113

# Grafias da wake word que o motor costuma produzir (JSON).
#GO2S_WAKE_WORDS=["hey jarvis","ei jarvis","hei jarvis","rei jarvis","e jarvis","ok jarvis","jarvis"]

# ─── Interpretação ────────────────────────────────────────────────────────────
#GO2S_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#GO2S_TAU_ACCEPT=0.95
#GO2S_TAU_MARGIN=0.10
#GO2S_MAX_CLAUSES=3

# ─── Fila ─────────────────────────────────────────────────────────────────────
#GO2S_QUEUE_MAX_COMMANDS=5
#GO2S_QUEUE_MAX_TOTAL_S=15
# 1 = frase nova substitui a fila; 0 = entra no fim.
#GO2S_REPLACE_QUEUE=1
# A fila é global (um robô só). replace = a frase de um edge substitui a de
# outro; reject = recusa a frase de outro edge enquanto houver fila.
#GO2S_CROSS_EDGE_POLICY=replace
# Frase mais velha que isto (relógio do servidor) não é executada.
#GO2S_MAX_UTTERANCE_AGE_S=4.0

# ─── Calibração ───────────────────────────────────────────────────────────────
# 1 = salva o áudio e o resultado de cada frase em GO2S_SAVE_DIR. É áudio de
# pessoas: avise quem está na sala e não versione a pasta.
#GO2S_SAVE_UTTERANCES=0
#GO2S_SAVE_DIR=captures
